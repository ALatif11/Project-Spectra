# Verified Luminal dashboard settings. Keep the real key only in ignored .env.
LUMINAL_API_KEY=your_luminal_api_key_here
LUMINAL_BASE_URL=https://flash.luminal.cloud/v1
LUMINAL_MODEL_ID=deepseek-ai/DeepSeek-V4.1-Flash

# These caps may be lowered, never raised.
MAX_AGENT_ROUNDS=3
MAX_LLM_CALLS=20
MAX_MODEL_EXPERIMENTS=12
MAX_OUTPUT_TOKENS=1000
# Optional request timeout (seconds, maximum 120).
LUMINAL_TIMEOUT_S=30
